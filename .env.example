# Copy to `.env` and fill in. `.env` is gitignored, so it is NOT in any repo
# backup — if you reinstall your OS, restore these from the Cloudflare Pages
# dashboard (Workers & Pages → your project → Settings → Environment variables).

# --- Required ---------------------------------------------------------------

# TMDB (film/series metadata). Free key: https://www.themoviedb.org/settings/api
# The TMDB key is now managed server-side by the resolver.

# Supabase (auth + settings sync). Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Stream resolver. Points at the self-hosted resolver (see
# pstream-backend/local-resolver/TERMUX.md). Falls back to the HF Space.
VITE_GIGA_BACKEND_URL=https://resolver.pstream.watch

# --- Optional ---------------------------------------------------------------



# NewPipe/Piped instance for trailer extraction
VITE_NEWPIPE_URL=
